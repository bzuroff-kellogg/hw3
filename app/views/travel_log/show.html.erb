
<h1><%= @place["name"] %></h1>


<ul>
  <% for entry in @entries %>
    <li>
        <h2><%= entry["title"] %> </h2>
       <p> <%= entry["occurred_on"] %></p>
       <p> <%= entry["description"] %></p>

    
    </li>
  <% end %>
</ul>

<p>
  <a href="/entries/new?place_id=<%= @place["id"] %>">New Entry</a>
</p>

<p><a href="/travel_log">Back to Places</a></p>

<form action="/travel_log/<%= @place["id"] %>" method="post">
</form>